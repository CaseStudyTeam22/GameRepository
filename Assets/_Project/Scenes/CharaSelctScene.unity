  - m_CharaType: 1
    m_Icon: {fileID: 21300000, guid: c3f88e3f6bcb976448799f1f6713633b, type: 3}
    m_CharacterName: Guardian
    m_Description: Write the explanation of the Guardian here.
  - m_CharaType: 2
    m_Icon: {fileID: 21300000, guid: 4755285a2ef46d54d91be7201703d7f3, type: 3}
    m_CharacterName: Fighter
    m_Description: "To Mr. Tanaka,  \nTo some Mr. Tanaka somewhere. Thank you always.
