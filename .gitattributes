# ==============================================================
# Line endings
# ==============================================================
* text=auto eol=lf

# Unity / C# text assets — force LF for cross-platform consistency
*.cs                 text eol=lf diff=csharp
*.shader             text eol=lf
*.cginc              text eol=lf
*.hlsl               text eol=lf
*.uxml               text eol=lf
*.uss                text eol=lf
*.json               text eol=lf
*.md                 text eol=lf
*.asmdef             text eol=lf
*.asmref             text eol=lf
*.unity              text eol=lf
*.prefab             text eol=lf
*.mat                text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.asset              text eol=lf
*.meta               text eol=lf
*.shadergraph        text eol=lf
*.shadersubgraph     text eol=lf
*.inputactions       text eol=lf
*.signal             text eol=lf
*.playable           text eol=lf
*.preset             text eol=lf
*.terrainlayer       text eol=lf
*.spriteatlas        text eol=lf
*.lighting           text eol=lf
*.giparams           text eol=lf

# Windows scripts: keep CRLF (.bat 必须 CRLF, 否则 Windows 双击执行会出错)
*.bat                text eol=crlf
*.cmd                text eol=crlf
*.ps1                text eol=crlf

# ==============================================================
# Git LFS — large/binary assets
# ==============================================================
# Images
*.png                filter=lfs diff=lfs merge=lfs -text
*.jpg                filter=lfs diff=lfs merge=lfs -text
*.jpeg               filter=lfs diff=lfs merge=lfs -text
*.gif                filter=lfs diff=lfs merge=lfs -text
*.bmp                filter=lfs diff=lfs merge=lfs -text
*.tga                filter=lfs diff=lfs merge=lfs -text
*.tif                filter=lfs diff=lfs merge=lfs -text
*.tiff               filter=lfs diff=lfs merge=lfs -text
*.psd                filter=lfs diff=lfs merge=lfs -text
*.exr                filter=lfs diff=lfs merge=lfs -text
*.hdr                filter=lfs diff=lfs merge=lfs -text

# Audio
